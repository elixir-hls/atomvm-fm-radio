# the block packages this application uses, by their names in mix.exs (scripts/env.sh of atomvm-tang25k-hls)
EHLS_BLOCKS=atomvm_tang25k_usb_host:atomvm_tang25k_rtlsdr:atomvm_tang25k_i2s:atomvm_tang25k_rpi_display_35inch
GW_PLACE=2   # Gowin placement: the one of default / 1 / 2 / 3 with the largest margin that passed the timing check (sweep_soc.sh)
